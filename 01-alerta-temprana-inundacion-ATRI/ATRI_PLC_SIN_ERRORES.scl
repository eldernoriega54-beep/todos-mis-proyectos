// ─────────────────────────────────────────────────────────────────────────────
// PROYECTO ATRI - SIEMENS S7-1214C DC/DC/DC
// 
// ENTRADAS (Arduino a PLC):
//   %I0.1 : Rele Nivel 1 (Verde)
//   %I0.2 : Rele Nivel 2 (Amarillo)
//   %I0.3 : Rele Nivel 3 (Rojo)
//
// SALIDAS (PLC a Lamparas):
//   %Q0.1 : Lampara Verde
//   %Q0.2 : Lampara Amarilla
//   %Q0.3 : Lampara Roja
// ─────────────────────────────────────────────────────────────────────────────

DATA_BLOCK "DB_ATRI"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN

STRUCT
    ReleNivel1      : BOOL;
    ReleNivel2      : BOOL;
    ReleNivel3      : BOOL;
    LamparaVerde    : BOOL;
    LamparaAmarilla : BOOL;
    LamparaRoja     : BOOL;
    NivelActual     : INT;
END_STRUCT;

BEGIN
    ReleNivel1      := FALSE;
    ReleNivel2      := FALSE;
    ReleNivel3      := FALSE;
    LamparaVerde    := FALSE;
    LamparaAmarilla := FALSE;
    LamparaRoja     := FALSE;
    NivelActual     := 0;
END_DATA_BLOCK


FUNCTION "FC_ATRI_Logica" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
    // 1. Leer las entradas fisicas directamente de los reles
    "DB_ATRI".ReleNivel1 := %I0.1;
    "DB_ATRI".ReleNivel2 := %I0.2;
    "DB_ATRI".ReleNivel3 := %I0.3;

    // 2. Prioridad de alertas (Rojo > Amarillo > Verde)
    IF "DB_ATRI".ReleNivel3 THEN
        "DB_ATRI".LamparaRoja     := TRUE;
        "DB_ATRI".LamparaAmarilla := FALSE;
        "DB_ATRI".LamparaVerde    := FALSE;
        "DB_ATRI".NivelActual     := 3;
    ELSIF "DB_ATRI".ReleNivel2 THEN
        "DB_ATRI".LamparaRoja     := FALSE;
        "DB_ATRI".LamparaAmarilla := TRUE;
        "DB_ATRI".LamparaVerde    := FALSE;
        "DB_ATRI".NivelActual     := 2;
    ELSIF "DB_ATRI".ReleNivel1 THEN
        "DB_ATRI".LamparaRoja     := FALSE;
        "DB_ATRI".LamparaAmarilla := FALSE;
        "DB_ATRI".LamparaVerde    := TRUE;
        "DB_ATRI".NivelActual     := 1;
    ELSE
        "DB_ATRI".LamparaRoja     := FALSE;
        "DB_ATRI".LamparaAmarilla := FALSE;
        "DB_ATRI".LamparaVerde    := FALSE;
        "DB_ATRI".NivelActual     := 0;
    END_IF;

    // 3. Activar las salidas fisicas para las lamparas
    %Q0.1 := "DB_ATRI".LamparaVerde;
    %Q0.2 := "DB_ATRI".LamparaAmarilla;
    %Q0.3 := "DB_ATRI".LamparaRoja;
END_FUNCTION
